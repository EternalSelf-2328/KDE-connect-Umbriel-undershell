#!/usr/bin/make -f
export UMBRIEL_BUILD_JOBS ?= 2
%:
	dh $@
override_dh_auto_configure:
	:
override_dh_auto_build:
	bash packaging/build.sh /usr $(CURDIR)/build/package-stage
override_dh_auto_install:
	mkdir -p $(CURDIR)/debian/tmp
	cp -a $(CURDIR)/build/package-stage/. $(CURDIR)/debian/tmp/
override_dh_auto_test:
	:
override_dh_makeshlibs:
	dh_makeshlibs -Xusr/lib/umbriel-connect
override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/tmp/usr/lib/umbriel-connect/engine/lib -- --ignore-missing-info
override_dh_auto_clean:
	rm -rf build
override_dh_installsystemduser:
	dh_installsystemduser --no-enable
